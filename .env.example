# Target and browser
TARGET_URL=https://academybugs.com/find-bugs/
HEADLESS=true

# Stage 1 discovery
EXPLORATION_TIME_SECONDS=60
MAX_EXPLORATION_DEPTH=3
MAX_BREADTH_PER_SCREEN=25

# Stage 2 journey testing
JOURNEY_TIME_BUDGET_SECONDS=600
MAX_JOURNEYS_TO_TEST=0
INVARIANT_MODE=SMART

# Optional LLM-as-judge. Set false for deterministic checks only.
LLM_JUDGE_ENABLED=false
LLM_PROVIDER=gemini
LLM_JUDGE_MODEL=gemini-2.5-flash
LLM_JUDGE_MIN_CONFIDENCE=0.8
LLM_JUDGE_SCREENSHOTS=false

# Supply only the key for the selected hosted provider.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local alternative:
# LLM_PROVIDER=ollama
# LLM_JUDGE_MODEL=llava
# OLLAMA_BASE_URL=http://localhost:11434
