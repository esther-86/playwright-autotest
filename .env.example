TARGET_URL=https://academybugs.com/find-bugs/
HEADLESS=FALSE
EXPLORATION_TIME_SECONDS=60
MAX_EXPLORATION_DEPTH=2
MAX_BREADTH_PER_SCREEN=50
INCLUDE_MENU_HEADER_FOOTER=false
EXCLUDED_URL_PATTERNS=cookie-policy,privacy-policy,terms

# LLM Provider: "ollama" (local/free), "gemini", "openai"
LLM_JUDGE_ENABLED=true
LLM_PROVIDER=gemini

# Stage 2: Journey Invariant Testing Settings
# "SMART" (universal errors + screen-relevant invariants) or "ALL" (runs all 18+ invariants)
INVARIANT_MODE=SMART
# Max journeys to test (0 = test all discovered journeys)
MAX_JOURNEYS_TO_TEST=0
# Journey execution time budget in seconds
JOURNEY_TIME_BUDGET_SECONDS=60

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434