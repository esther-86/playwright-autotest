    "explore": "PATH=\"$HOME/.nvm/versions/node/v20.19.6/bin:$PATH\" tsx src/explorer.ts",
    "explore:headed": "HEADLESS=false PATH=\"$HOME/.nvm/versions/node/v20.19.6/bin:$PATH\" tsx src/explorer.ts"
  },
